  "invariants": [
    {
      "id": "idem-001",
      "name": "Idempotent Replay",
      "description": "A retry with the same Idempotency-Key returns the same response and creates no new ledger entry."
    },
    {
      "id": "ledger-001",
      "name": "Ledger Balance Consistency",
      "description": "A 200 means the sender lost exactly the amount and the recipient gained exactly the amount; a failed request moves nothing."
    },
    {
      "id": "pii-001",
      "name": "PII Protection",
      "description": "No response contains a full account or ID number."
    }
  ],
